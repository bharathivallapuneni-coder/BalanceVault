# Server Port Configuration (Dev runs on 3000)
PORT=3000


# APP_URL: Auto-injected at runtime with Cloud Run URL
APP_URL="MY_APP_URL"

# JSON Web Token Secret
JWT_SECRET="balancevault_super_secret_jwt_key_for_development_purposes_only"

# First Admin Bootstrap Configuration
BOOTSTRAP_ADMIN_EMAIL="admin@balancevault.internal"
BOOTSTRAP_ADMIN_PASSWORD="VaultAdmin@2026!"
BOOTSTRAP_ADMIN_NAME="Platform Master Admin"

# Optional Redis Connection URL for Distributed Rate Limiting
REDIS_URL="redis://127.0.0.1:6379"
